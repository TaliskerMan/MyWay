# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Experimental spikes and stray compiled test binaries / images (P2-9).
# Kept locally for reference but must not ship in the tree.
/scratch/
/test_audio
/test_audio.c
/test_gdbus
/test_pipeline
/test_xid_c*
test_xid_c*.png
/packaging/

# ---- Build output (belongs in ~/NOBuilds per L-Release) ----
build/
local-build/
.dart_tool/
.dart_tools_tmp/
.pybuild/

# ---- Packaging and staging trees ----
packaging/*/staging/
packaging/*/artifacts/
packaging/*_amd64/
packaging/*_arm64/
packaging/deb_pkg/
artifacts/

# ---- Compiled outputs ----
*.so
*.dylib
*.a
*.dill
*.framework/

# ---- Release packages ----
*.deb
*.dmg
*.rpm
*.msi
*.AppImage
*.tar.gz

# ---- Vendored tool binaries ----
bin/

